PORT=3001
NODE_ENV=development

# PostgreSQL Database (Cloud SQL local emulation)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=clt_admin
DATABASE_PASSWORD=clt_password_local
DATABASE_NAME=clt_erp_dev

# Business Timezone
TZ=Asia/Ho_Chi_Minh

# Phase A: Google Sheets is the system of record. No write-back.
LEGACY_PHASE=shadow
LEGACY_SOURCE=sheets
LEGACY_SPREADSHEET_ID=1-ADW3SxNi_ailWvrOUMso8wg8Gga4hVIqvNdq6bws1I
# Optional XLSX fallback. Absolute paths are recommended.
# LEGACY_XLSX_PATH=/absolute/path/to/legacy.xlsx
# Use ADC (gcloud locally or an attached GCP service account).
# Only if using a local service-account key, keep it OUTSIDE the repository:
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/companylab-reader.json
