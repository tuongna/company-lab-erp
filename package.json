{
  "name": "companylab-erp",
  "version": "0.1.0",
  "private": true,
  "description": "CompanyLab ERP platform replacing Google Sheets workflows",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:up": "docker compose -f infra/docker-compose.yml up -d",
    "db:down": "docker compose -f infra/docker-compose.yml down",
    "db:migrate": "pnpm --filter @companylab/api db:migrate",
    "db:seed": "pnpm --filter @companylab/api db:seed",
    "db:seed:excel": "pnpm --filter @companylab/api db:seed:excel",
    "legacy:sync-sheets": "pnpm --filter @companylab/api db:seed",
    "legacy:check-sheets": "pnpm --filter @companylab/api exec ts-node src/modules/legacy-sync/scripts/test-google-sheets.ts",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json}\"",
    "graph": "turbo run build --graph=docs/architecture/task-graph.html",
    "prepare": "husky",
    "sync:run": "pnpm --filter @companylab/api sync:run"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.5.0",
    "turbo": "^2.4.4",
    "typescript": "^5.7.3"
  }
}
